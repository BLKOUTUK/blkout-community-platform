# BLKOUT Community Platform - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ============================================================================
# Supabase Database Configuration
# ============================================================================
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# ============================================================================
# BLKOUTHUB Integration - Heartbeat.chat API
# ============================================================================
# Get these from: https://heartbeat.chat/admin → Settings → API & Integrations

# Heartbeat.chat API Token (required for member verification)
# Permissions needed: Read Users, Read Communities, Read Groups, Read Roles
HEARTBEAT_API_TOKEN="your-heartbeat-api-token-here"

# Your BLKOUTHUB Community ID on Heartbeat.chat
# Find in: Settings → General → Community ID
BLKOUTHUB_COMMUNITY_ID="your-community-id-here"

# Internal API token for webhook authentication (generate secure random token)
# Use: openssl rand -base64 32
BLKOUTHUB_BEARER_TOKEN="your-secure-random-token-here"

# ============================================================================
# Optional: Development Mode
# ============================================================================
# Set to 'development' to use mock data for BLKOUTHUB integration
NODE_ENV="development"

# Enable debug logging for BLKOUTHUB integration
DEBUG_BLKOUTHUB="false"

# ============================================================================
# NOTES:
# ============================================================================
# 1. NEVER commit .env.local to version control
# 2. Use different tokens for development/staging/production
# 3. Rotate API tokens every 90 days for security
# 4. Without Heartbeat.chat credentials, the integration will use mock data
# 5. See docs/BLKOUTHUB_INTEGRATION_GUIDE.md for setup instructions
